# Copy to `spinup.env` (gitignored) and fill in. NEVER commit spinup.env or paste
# the key into chat. The RLS key must be scoped to THIS campaign (each new vertical
# mints its own in Studio → Campaign Settings → API).

RLS_BASE_URL=https://api.studio.mercor.com
RLS_API_KEY=

# Studio IDs for the new campaign (Campaign Settings / GET /campaigns/).
# NOTE: current Sparta verticals share one company/account, but a new vertical may
# have its own — take these from the campaign itself, don't assume.
CAMPAIGN_ID=
COMPANY_ID=
ACCOUNT_ID=

# The campaign's OWN Prometheus/Taiga environment id. Do NOT copy another vertical's
# (clones leak it). Confirm from the campaign's prometheus_sync config / a known-good
# live Taiga run / the vertical's CLAUDE.md.
PROMETHEUS_ENV=

# QC-spec ids for this campaign, resolved by name from QC_SPECS
# (SCOPE_TYPE=campaign). Names: "Task AutoQC", "Trajectory AutoQC",
# "Failure Analysis & Grader Analysis AutoQC", "Preference Labels AutoQC".
QC_TASK_AUTOQC=
QC_TRAJECTORY_AUTOQC=
QC_FA_GRADER_AUTOQC=
QC_PREF_LABELS_AUTOQC=

# Optional: comma-separated world ids to target. Leave blank to auto-discover
# live, canonical-flow tasking worlds in the campaign.
TARGET_WORLD_IDS=
